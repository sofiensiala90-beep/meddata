rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper to get user data safely
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function isAdmin() {
      // Check if signed in, if user doc exists (not null), and if role is admin
      // This pattern is robust and handles missing user documents gracefully
      return isSignedIn() && 
             getUserData() != null && 
             getUserData().data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    // USERS
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Rule 1: Admin or Owner can update anything
      // Rule 2: P2P Transfer - Any signed-in user can update ONLY 'coinBalance' of another user (for transfers)
      allow update: if isAdmin() || isOwner(userId) || 
                    (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coinBalance']));
    }

    // FORMS
    match /forms/{formId} {
      allow read: if resource.data.isPublic == true || isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // RESPONSES
    match /responses/{responseId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // TRANSACTIONS
    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
    }

    // PURCHASED FORMS
    match /purchasedForms/{purchaseId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn(); 
      allow update: if isOwner(resource.data.userId); 
    }

    // ACTIVITY LOGS
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
    
    // COMPLAINTS
    match /complaints/{complaintId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // DELETED ITEMS (Trash)
    // IMPORTANT: Ensure these rules are deployed to Firebase Console
    match /deletedItems/{itemId} {
      allow create: if isSignedIn(); // Allow soft delete
      allow read, delete: if isAdmin(); // Admin only management
    }
    
    // AI ANALYSIS HISTORY
    match /analysisHistory/{historyId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // UNLOCKED ANALYSIS
    match /unlockedAnalysis/{unlockId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
    }

    // SYSTEM SETTINGS
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}