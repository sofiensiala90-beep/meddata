rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // Check existence first to prevent errors during signup/initialization
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    // USERS
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      
      // Rule 1: Admin or Owner can update anything
      allow update: if isAdmin() || isOwner(userId);
      
      // Rule 2: P2P Transfer - Any signed-in user can update ONLY 'coinBalance' of another user
      // This is required for Student A to send coins to Student B
      allow update: if isSignedIn() && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coinBalance']);
    }

    // FORMS
    match /forms/{formId} {
      allow read: if resource.data.isPublic == true || isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // RESPONSES
    match /responses/{responseId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // TRANSACTIONS
    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
    }

    // PURCHASED FORMS
    match /purchasedForms/{purchaseId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn(); // Allow creating notifications for others (e.g. Admin -> Student, or Student -> Admin)
      allow update: if isOwner(resource.data.userId); // Allow marking as read
    }

    // ACTIVITY LOGS
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
    
    // COMPLAINTS (New) - Added specifically to fix the permission error
    match /complaints/{complaintId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
    
    // AI ANALYSIS HISTORY
    match /analysisHistory/{historyId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // UNLOCKED ANALYSIS
    match /unlockedAnalysis/{unlockId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
    }

    // SYSTEM SETTINGS
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}