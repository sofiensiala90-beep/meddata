rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper to get user data safely
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function isAdmin() {
      // Robust check: signed in AND doc exists AND role is admin
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    // USERS
    match /users/{userId} {
      allow read: if isSignedIn(); // Needed for searching users by email
      allow create: if isSignedIn();
      
      // UPDATE RULES:
      // 1. P2P/Commission: Allow updating ONLY 'coinBalance' by any signed-in user.
      //    (This covers transfers and paying commissions to creators).
      // 2. Self: Owner can update their own profile.
      // 3. Admin: Can update everything.
      allow update: if (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coinBalance'])) ||
                    isOwner(userId) || 
                    isAdmin();
    }

    // FORMS
    match /forms/{formId} {
      allow read: if resource.data.isPublic == true || isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
      // Ensure resource exists before checking data to avoid null pointer errors during delete
      allow update, delete: if (resource != null && isOwner(resource.data.userId)) || isAdmin();
    }

    // RESPONSES
    match /responses/{responseId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // TRANSACTIONS
    match /transactions/{transactionId} {
      // Owner can see their own txs, Admin sees all
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // Anyone can create a transaction record (e.g. sending money to someone else creates a record for them)
      allow create: if isSignedIn();
    }

    // PURCHASED FORMS
    match /purchasedForms/{purchaseId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      // Allow creating notifications for others (e.g. transfer receipt, admin alerts)
      allow create: if isSignedIn(); 
      allow update: if isOwner(resource.data.userId); 
    }

    // ACTIVITY LOGS
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
    
    // COMPLAINTS
    match /complaints/{complaintId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // DELETED ITEMS (Trash)
    match /deletedItems/{itemId} {
      // Allow write (create/update/delete) for any signed-in user to ensure soft-delete works.
      // Since IDs are random, users can't easily overwrite others' trash items.
      allow write: if isSignedIn();
      // Only Admin can list/read trash items
      allow read: if isAdmin();
    }
    
    // AI ANALYSIS HISTORY
    match /analysisHistory/{historyId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // UNLOCKED ANALYSIS
    match /unlockedAnalysis/{unlockId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn();
    }

    // SYSTEM SETTINGS
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}